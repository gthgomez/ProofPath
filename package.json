{
  "name": "careerforge-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "report:content": "tsx scripts/report-content.ts",
    "scan:redaction": "tsx scripts/scan-sandbox-redaction.ts",
    "verify": "npm run validate:content && npm run report:content && npm run scan:redaction && npm run typecheck && npm run test",
    "prepare:sandbox-assets": "node scripts/copy-sandbox-assets.js",
    "postinstall": "node scripts/copy-sandbox-assets.js",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production"
  },
  "dependencies": {
    "expo": "~55.0.20",
    "expo-constants": "~55.0.15",
    "expo-linking": "~55.0.14",
    "expo-router": "55.0.13",
    "expo-sqlite": "~55.0.15",
    "expo-status-bar": "55.0.5",
    "pyodide": "^0.29.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "4.23.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "^13.16.1",
    "sql.js": "^1.14.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  }
}
